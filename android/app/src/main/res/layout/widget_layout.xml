<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!-- Glowing Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="#00F2FE"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY'S TASKS"
            android:textColor="#00F2FE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- Task List Container -->
    <LinearLayout
        android:id="@+id/tasks_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:orientation="vertical">

        <!-- Task 1 -->
        <TextView
            android:id="@+id/task_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Put on a new patch"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginVertical="4dp"
            android:visibility="gone" />

        <!-- Task 2 -->
        <TextView
            android:id="@+id/task_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Go to the gym"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginVertical="4dp"
            android:visibility="gone" />

        <!-- Task 3 -->
        <TextView
            android:id="@+id/task_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Walk the dog"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginVertical="4dp"
            android:visibility="gone" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/widget_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All clear! No tasks due today. 🎉"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginVertical="12dp"
            android:visibility="visible" />
    </LinearLayout>
</RelativeLayout>
